<view class="page {{(canStart || canSubmit) ? 'page-with-footer' : ''}}">
  <view wx:if="{{loading && !summary}}" class="loading-more">加载中…</view>
  <view wx:elif="{{error && !summary}}" class="error-box" bindtap="onRetry">{{error}}
    <view class="retry-btn">点击重试</view>
  </view>

  <block wx:if="{{summary}}">
    <!-- 工单概览 -->
    <view class="card">
      <view class="card-title">
        <text>工单 {{summary.orderNo}}</text>
        <text class="tag {{statusClass}}">{{summary.status}}</text>
      </view>
      <view class="row">
        <text class="k">工单类型</text>
        <text class="v"><text class="tag {{typeClass}}">{{summary.orderTypeLabel}}</text></text>
      </view>
      <view class="row"><text class="k">负责人</text><text class="v">{{summary.ownerName || '—'}}</text></view>
      <view class="row"><text class="k">计划日期</text><text class="v">{{plannedDateText}}</text></view>
      <view class="row"><text class="k">报修单号</text><text class="v">{{summary.requestNo || '—'}}</text></view>
      <view class="row"><text class="k">故障类型</text><text class="v">{{summary.faultType || '—'}}</text></view>
      <view class="row"><text class="k">紧急程度</text><text class="v">{{summary.urgency || '—'}}</text></view>
      <view class="row"><text class="k">本单总费用</text><text class="v">{{costText}}</text></view>
    </view>

    <!-- 设备信息 -->
    <view class="card">
      <view class="card-title">设备信息</view>
      <view class="row"><text class="k">设备编号</text><text class="v">{{summary.equipmentCode}}</text></view>
      <view class="row"><text class="k">设备名称</text><text class="v">{{summary.equipmentName}}</text></view>
      <view class="row"><text class="k">所属部门</text><text class="v">{{summary.department}}</text></view>
      <view class="row"><text class="k">使用位置</text><text class="v">{{summary.location}}</text></view>
    </view>

    <!-- 故障描述 / 保养内容 -->
    <view class="card">
      <view class="card-title">{{isMaintenance ? '保养内容' : '故障描述'}}</view>
      <view class="desc-text">{{taskContent || '—'}}</view>
      <view class="divider"></view>
      <view class="row"><text class="k">报修时间</text><text class="v">{{discoveredAtText}}</text></view>
      <view class="row"><text class="k">报修人</text><text class="v">{{summary.reporterName || '—'}}</text></view>
      <view class="row"><text class="k">工单创建</text><text class="v">{{createdAtText}}</text></view>
      <view class="row" wx:if="{{startedAtText}}"><text class="k">开工时间</text><text class="v">{{startedAtText}}</text></view>
      <view class="row" wx:if="{{completedAtText}}"><text class="k">完工时间</text><text class="v">{{completedAtText}}</text></view>
    </view>

    <!-- 故障现场照片 -->
    <view class="card" wx:if="{{repairPhotos.length}}">
      <view class="card-title">
        <text>故障现场照片</text>
        <text class="card-extra">{{repairPhotos.length}} 张 · 点击查看原图</text>
      </view>
      <view class="photo-grid">
        <view class="photo-cell" wx:for="{{repairPhotos}}" wx:key="attachmentId" data-index="{{index}}" bindtap="previewRepairPhoto">
          <image wx:if="{{item.localPath}}" src="{{item.localPath}}" mode="aspectFill" />
          <view wx:else class="photo-loading">{{item.loadError ? '加载失败' : '加载中'}}</view>
        </view>
      </view>
    </view>

    <!-- 到场核对 -->
    <view class="card" wx:if="{{canStart || canSubmit}}">
      <view class="card-title">
        <text>到场核对</text>
        <text class="tag {{verified === 1 ? 'tag-green' : (verified === 2 ? 'tag-red' : 'tag-gray')}}">{{verified === 1 ? '核对一致' : (verified === 2 ? '核对不一致' : '未核对')}}</text>
      </view>
      <view class="hint">到场后扫描设备二维码核对工单设备；核对不一致时不得提交完工。</view>
      <view class="hint-success verify-msg" wx:if="{{verified === 1 && verifyMessage}}">{{verifyMessage}}</view>
      <view class="hint-error verify-msg" wx:if="{{verified === 2 && verifyMessage}}">{{verifyMessage}}</view>
      <button class="btn btn-ghost verify-btn" bindtap="onScanVerify">📷 扫码核对设备</button>
    </view>

    <!-- 验收退回意见 -->
    <view class="card" wx:if="{{returnOpinionText}}">
      <view class="card-title">
        <text>验收意见（退回）</text>
        <text class="tag tag-red">需整改</text>
      </view>
      <view class="hint-error">{{returnOpinionText}}</view>
      <view class="hint return-hint">请追加整改记录并重新提交完工。</view>
    </view>

    <!-- 维修处理表单（处理中才可填写） -->
    <view class="card" wx:if="{{canSubmit}}">
      <view class="card-title">填写维修过程</view>

      <view class="field">
        <view class="field-label">
          <text>故障原因</text>
          <text class="field-hint">{{form.cause.length}}/500</text>
        </view>
        <textarea
          class="textarea"
          placeholder="简述故障原因（选填，不超过 500 字）"
          placeholder-class="input-placeholder"
          value="{{form.cause}}"
          maxlength="500"
          auto-height
          bindinput="onCauseInput"
        />
      </view>

      <view class="field">
        <view class="field-label">
          <text>维修过程</text>
          <text class="field-hint">{{form.process.length}}/1000</text>
        </view>
        <textarea
          class="textarea"
          placeholder="记录拆检、更换、调试等过程（选填，不超过 1000 字）"
          placeholder-class="input-placeholder"
          value="{{form.process}}"
          maxlength="1000"
          auto-height
          bindinput="onProcessInput"
        />
      </view>

      <view class="field">
        <view class="field-label">
          <text>处理结果<text class="required">*</text></text>
          <text class="field-hint">{{form.result.length}}/1500</text>
        </view>
        <textarea
          class="textarea"
          placeholder="说明修复情况与试机结果（必填，不超过 1500 字）"
          placeholder-class="input-placeholder"
          value="{{form.result}}"
          maxlength="1500"
          auto-height
          bindinput="onResultInput"
        />
      </view>

      <view class="field">
        <view class="field-label">
          <text>更换零部件说明</text>
          <text class="field-hint">{{form.replacedParts.length}}/500</text>
        </view>
        <textarea
          class="textarea textarea-small"
          placeholder="如：7014C 轴承 ×2（选填）"
          placeholder-class="input-placeholder"
          value="{{form.replacedParts}}"
          maxlength="500"
          auto-height
          bindinput="onPartsInput"
        />
      </view>

      <view class="field">
        <view class="field-label">
          <text>本单总费用（元）<text class="required">*</text></text>
          <text class="field-hint">整单总额，不是累加</text>
        </view>
        <input
          class="input"
          type="digit"
          placeholder="如 120.50（≥0，最多两位小数）"
          placeholder-class="input-placeholder"
          value="{{form.totalCost}}"
          bindinput="onCostInput"
        />
      </view>

      <view class="field">
        <view class="field-label">
          <text>完工照片<text class="required">*</text></text>
          <text class="field-hint">{{photos.length}}/{{maxPhotoCount}} · 至少 1 张</text>
        </view>
        <view class="photo-grid">
          <view class="photo-cell" wx:for="{{photos}}" wx:key="key">
            <image src="{{item.tempFilePath}}" mode="aspectFill" data-index="{{index}}" bindtap="previewPhoto" />
            <view class="photo-close" data-index="{{index}}" catchtap="removePhoto">×</view>
            <view class="photo-mask" wx:if="{{item.status === 'uploading'}}">上传中 {{item.progress}}%</view>
            <view class="photo-mask" wx:elif="{{item.status === 'failed'}}" data-index="{{index}}" catchtap="retryPhoto">上传失败，点击重试</view>
            <view class="photo-mask" wx:elif="{{item.status === 'done'}}">已上传</view>
          </view>
          <view class="photo-add" wx:if="{{photos.length < maxPhotoCount}}" bindtap="choosePhoto">
            <text class="photo-add-icon">＋</text>
            <text>添加照片</text>
          </view>
        </view>
        <view class="hint" style="margin-top: 16rpx;">最多 6 张，单张不超过 5 MB，JPG/PNG；提交时逐张上传，失败可单张重试。</view>
      </view>
    </view>

    <!-- 验收记录 -->
    <view class="card" wx:if="{{acceptances.length}}">
      <view class="card-title">验收记录</view>
      <view class="record" wx:for="{{acceptances}}" wx:key="acceptanceId">
        <view class="record-head">
          <text class="record-title">验收人：{{item.inspectorName || '—'}}</text>
          <text class="tag {{item.result === 'PASS' ? 'tag-green' : 'tag-red'}}">{{item.resultLabel}}</text>
        </view>
        <view class="row row-block" wx:if="{{item.opinion}}"><text class="k">验收意见</text><text class="v">{{item.opinion}}</text></view>
        <view class="record-time">{{item.acceptedAtText}}</view>
      </view>
    </view>

    <!-- 处理记录 -->
    <view class="card" wx:if="{{records.length}}">
      <view class="card-title">
        <text>处理记录</text>
        <text class="card-extra">{{records.length}} 条</text>
      </view>
      <view class="record" wx:for="{{records}}" wx:key="recordId">
        <view class="record-head">
          <text class="record-title">第 {{index + 1}} 次提交 · {{item.operatorName || '—'}}</text>
          <text class="record-time">{{item.submittedAtText}}</text>
        </view>
        <view class="row row-block" wx:if="{{item.cause}}"><text class="k">故障原因</text><text class="v">{{item.cause}}</text></view>
        <view class="row row-block" wx:if="{{item.process}}"><text class="k">维修过程</text><text class="v">{{item.process}}</text></view>
        <view class="row row-block" wx:if="{{item.result}}"><text class="k">处理结果</text><text class="v">{{item.result}}</text></view>
        <view class="row row-block" wx:if="{{item.replacedParts}}"><text class="k">更换零部件</text><text class="v">{{item.replacedParts}}</text></view>
        <view class="row row-block"><text class="k">费用快照</text><text class="v">{{item.costText}}</text></view>
        <view class="photo-grid record-photos" wx:if="{{item.photos.length}}">
          <view
            class="photo-cell"
            wx:for="{{item.photos}}"
            wx:for-item="photo"
            wx:for-index="photoIndex"
            wx:key="attachmentId"
            data-record="{{index}}"
            data-index="{{photoIndex}}"
            bindtap="previewRecordPhoto"
          >
            <image wx:if="{{photo.localPath}}" src="{{photo.localPath}}" mode="aspectFill" />
            <view wx:else class="photo-loading">{{photo.loadError ? '加载失败' : '加载中'}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 只读提示 -->
    <view class="card" wx:if="{{readOnly}}">
      <view class="card-title">当前状态</view>
      <view class="hint">{{statusHint}}</view>
    </view>
  </block>

  <view class="error-box" wx:if="{{error && summary}}" bindtap="onRetry">{{error}}（点击重试）</view>
</view>

<view class="footer-bar" wx:if="{{canStart}}">
  <button class="btn btn-primary" loading="{{starting}}" disabled="{{starting}}" bindtap="onStart">开始维修</button>
</view>

<view class="footer-bar" wx:if="{{canSubmit}}">
  <button class="btn btn-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmitComplete">提交完工</button>
</view>
