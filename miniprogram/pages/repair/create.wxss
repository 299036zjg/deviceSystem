.create-btn-row {
  margin-top: 24rpx;
}

.create-manual {
  margin-top: 20rpx;
}

.manual-row {
  display: flex;
  align-items: center;
}

.manual-input {
  flex: 1;
}

.manual-btn {
  flex: 0 0 150rpx;
  margin-left: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.datetime-row {
  display: flex;
}

.datetime-picker {
  flex: 1;
}

.datetime-picker + .datetime-picker {
  margin-left: 16rpx;
}

.input-placeholder {
  color: #a6acbd;
}
