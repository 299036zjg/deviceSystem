/**
 * 全局样式：统一的卡片、表单、按钮、标签与相册网格
 * 主色 #2f6fed，圆角 20rpx，页面留白 24rpx
 */
page {
  background: #f5f6fa;
  color: #1f2430;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  line-height: 1.5;
  box-sizing: border-box;
}

view,
text,
input,
textarea,
button,
image {
  box-sizing: border-box;
}

/* ---------- 页面容器 ---------- */
.page {
  padding: 24rpx 24rpx 60rpx;
}

.page-with-footer {
  padding-bottom: 200rpx;
}

/* ---------- 卡片 ---------- */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(47, 111, 237, 0.06);
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2430;
  margin-bottom: 20rpx;
}

.card-title .card-extra {
  font-size: 24rpx;
  font-weight: 400;
  color: #8b93a7;
}

.card-subtitle {
  font-size: 24rpx;
  color: #8b93a7;
  margin-bottom: 16rpx;
}

/* ---------- 键值行 ---------- */
.row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 10rpx 0;
}

.row .k {
  flex: 0 0 176rpx;
  color: #8b93a7;
  font-size: 26rpx;
}

.row .v {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #1f2430;
  word-break: break-all;
}

.row-left .v {
  text-align: left;
}

.row-block {
  display: block;
  padding: 12rpx 0;
}

.row-block .k {
  display: block;
  margin-bottom: 8rpx;
}

.row-block .v {
  display: block;
  text-align: left;
  white-space: pre-wrap;
  color: #3c4254;
}

.divider {
  height: 1rpx;
  background: #eef0f5;
  margin: 16rpx 0;
}

/* ---------- 标签（文字 + 颜色双重表达） ---------- */
.tag {
  display: inline-block;
  padding: 2rpx 16rpx;
  border-radius: 100rpx;
  font-size: 22rpx;
  line-height: 1.7;
}

.tag-orange {
  color: #b25e09;
  background: #fff3e2;
}

.tag-blue {
  color: #1c4fc4;
  background: #e8efff;
}

.tag-purple {
  color: #6133c4;
  background: #f1eaff;
}

.tag-green {
  color: #1f7a3f;
  background: #e5f7eb;
}

.tag-red {
  color: #b42318;
  background: #fee9e7;
}

.tag-gray {
  color: #5b6274;
  background: #eef0f5;
}

/* ---------- 按钮 ---------- */
.btn {
  border-radius: 14rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  padding: 0 32rpx;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: #2f6fed;
  color: #ffffff;
}

.btn-primary.btn-plain {
  background: #e8efff;
  color: #2f6fed;
}

.btn-ghost {
  background: #ffffff;
  color: #2f6fed;
  border: 2rpx solid #c8d9fb;
}

.btn-danger {
  background: #fee9e7;
  color: #b42318;
}

.btn-block {
  width: 100%;
  display: block;
}

.btn[disabled] {
  opacity: 0.5;
}

.btn-mini {
  display: inline-block;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  border-radius: 10rpx;
  padding: 0 24rpx;
}

.btn-row {
  display: flex;
  gap: 20rpx;
}

.btn-row .btn {
  flex: 1;
}

/* ---------- 表单 ---------- */
.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.field-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #5b6274;
  margin-bottom: 12rpx;
}

.field-label .required {
  color: #e5484d;
  margin-left: 6rpx;
}

.field-label .field-hint {
  font-size: 22rpx;
  color: #a6acbd;
}

.input {
  height: 88rpx;
  background: #f7f8fb;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2430;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  background: #f7f8fb;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1f2430;
}

.counter {
  text-align: right;
  font-size: 22rpx;
  color: #8b93a7;
  margin-top: 8rpx;
}

.picker-value {
  height: 88rpx;
  line-height: 88rpx;
  background: #f7f8fb;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2430;
}

.picker-value.placeholder {
  color: #a6acbd;
}

/* ---------- 相册网格 ---------- */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.photo-cell {
  width: 196rpx;
  height: 196rpx;
  margin: 8rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f2f4f9;
  position: relative;
}

.photo-cell image {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-cell .photo-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 6rpx 10rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(31, 36, 48, 0.55);
}

.photo-cell .photo-close {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #ffffff;
  background: rgba(31, 36, 48, 0.55);
  border-bottom-left-radius: 12rpx;
}

.photo-add {
  width: 196rpx;
  height: 196rpx;
  margin: 8rpx;
  border: 2rpx dashed #c8d4ea;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8b93a7;
  font-size: 22rpx;
}

.photo-add .photo-add-icon {
  font-size: 48rpx;
  line-height: 1.2;
  color: #a6acbd;
}

.photo-loading {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #8b93a7;
  background: #f2f4f9;
}

/* ---------- 列表项 ---------- */
.list-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(47, 111, 237, 0.05);
}

.list-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.list-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2430;
}

.list-item-sub {
  font-size: 24rpx;
  color: #8b93a7;
  margin-top: 8rpx;
}

.list-item-desc {
  font-size: 26rpx;
  color: #3c4254;
  margin-top: 12rpx;
  line-height: 1.5;
}

.list-item-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8b93a7;
}

/* ---------- 状态提示 ---------- */
.empty {
  padding: 100rpx 0;
  text-align: center;
  color: #8b93a7;
  font-size: 26rpx;
}

.empty .empty-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.error-box {
  padding: 60rpx 0;
  text-align: center;
  color: #b42318;
  font-size: 26rpx;
}

.loading-more,
.no-more {
  text-align: center;
  font-size: 24rpx;
  color: #a6acbd;
  padding: 24rpx 0;
}

.hint {
  font-size: 24rpx;
  color: #8b93a7;
  line-height: 1.6;
}

.hint-warn {
  font-size: 24rpx;
  color: #b25e09;
  background: #fff8ec;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  line-height: 1.6;
}

.hint-error {
  font-size: 24rpx;
  color: #b42318;
  background: #fef3f2;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  line-height: 1.6;
}

.hint-success {
  font-size: 24rpx;
  color: #1f7a3f;
  background: #eefaf2;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  line-height: 1.6;
}

/* ---------- 顶部 tab ---------- */
.tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(47, 111, 237, 0.05);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #5b6274;
  border-radius: 12rpx;
}

.tab-active {
  background: #e8efff;
  color: #2f6fed;
  font-weight: 600;
}

/* ---------- 底部操作栏 ---------- */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(31, 36, 48, 0.06);
  z-index: 10;
}

.footer-bar .btn {
  flex: 1;
}
